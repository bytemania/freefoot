{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xg.schema.json",
  "title": "xg.yaml",
  "type": "object",
  "properties": {
    "source": {
      "type": "string"
    },
    "fitDate": {
      "type": "string"
    },
    "logistic": {
      "type": "object",
      "properties": {
        "intercept": {
          "type": "number"
        },
        "distance": {
          "type": "number"
        },
        "angle": {
          "type": "number"
        },
        "header": {
          "type": "number"
        },
        "defendersInCone": {
          "type": "number"
        },
        "assistType": {
          "type": "object",
          "properties": {
            "none": {
              "type": "number"
            },
            "cross": {
              "type": "number"
            },
            "through": {
              "type": "number"
            },
            "cutback": {
              "type": "number"
            },
            "setPiece": {
              "type": "number"
            }
          },
          "required": [
