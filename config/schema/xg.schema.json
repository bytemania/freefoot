    "penaltyXg": {
      "type": "number"
    },
    "psxg": {
      "type": "object",
      "properties": {
        "base": {
          "type": "number"
        },
        "placementWeight": {
          "type": "number"
        },
        "speedWeight": {
          "type": "number"
        },
        "speedRef": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      },
      "required": [
        "base",
        "placementWeight",
        "speedWeight",
        "speedRef",
        "max"
      ],
      "additionalProperties": false
