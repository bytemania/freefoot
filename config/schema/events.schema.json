{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "events.schema.json",
  "title": "events.yaml",
  "type": "object",
  "properties": {
    "types": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z][A-Z_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "actors": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "actor",
                "secondary"
              ]
            },
            "uniqueItems": true
          },
          "meta": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[A-Za-z]+$"
            },
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string",
                  "enum": [
                    "number",
                    "boolean",
                    "string"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "string"
                      ]
                    },
                    "values": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    }
                  },
                  "required": [
                    "type",
                    "values"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "minProperties": 0
          },
          "commentaryBy": {
            "type": "string",
            "pattern": "^[A-Za-z]+$"
          },
          "highlight": {
            "type": "boolean"
          },
          "forcesPause": {
            "type": "boolean"
          },
          "minVariations": {
            "type": "integer",
            "minimum": 1
          },
          "stats": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "metric": {
                  "type": "string",
                  "pattern": "^[A-Za-z]+$"
                },
                "side": {
                  "type": "string",
                  "enum": [
                    "actor",
                    "opponent"
                  ]
                },
                "inc": {
                  "type": "number"
                },
                "incFrom": {
                  "type": "string"
                },
                "when": {
                  "type": "object",
                  "propertyNames": {
                    "pattern": "^[A-Za-z]+$"
                  },
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "boolean"
                          }
                        ]
                      },
                      {
                        "type": "array",
                        "items": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "number"
                            },
                            {
                              "type": "boolean"
                            }
                          ]
                        },
                        "minItems": 1
                      }
                    ]
                  },
                  "minProperties": 1
                }
              },
              "required": [
                "metric",
                "side"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "actors",
          "meta",
          "highlight",
          "forcesPause",
          "minVariations",
          "stats"
        ],
        "additionalProperties": false
      },
      "minProperties": 1
    },
    "derived": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z]+$"
      },
      "uniqueItems": true
    },
    "matchLevel": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z]+$"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "types",
    "derived",
    "matchLevel"
  ],
  "additionalProperties": false
}
