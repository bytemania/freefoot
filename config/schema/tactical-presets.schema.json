{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tactical-presets.schema.json",
  "title": "tactical-presets.yaml",
  "type": "object",
  "properties": {
    "defaultSlots": {
      "type": "object",
      "properties": {
        "planA": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "planB": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        }
      },
      "required": ["planA", "planB"],
      "additionalProperties": false
    },
    "defaultFormations": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[0-9](-[0-9]){2,4}$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100
      },
      "minProperties": 1
    },
    "presets": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "formationId": {
            "type": "string",
            "pattern": "^[0-9](-[0-9]){2,4}$"
          },
          "instructions": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "defaultInstrFam": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": ["id", "formationId", "instructions", "defaultInstrFam"],
        "additionalProperties": false
      }
    }
  },
  "required": ["defaultSlots", "defaultFormations", "presets"],
  "additionalProperties": false
}
