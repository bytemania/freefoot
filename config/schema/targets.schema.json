{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "targets.schema.json",
  "title": "targets.yaml",
  "type": "object",
  "properties": {
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z]+$"
          },
          "unit": {
            "type": "string",
            "enum": [
              "perTeam",
              "perMatch"
            ]
          },
          "layer": {
            "type": "string",
            "enum": [
              "L1",
              "L2",
              "L3",
              "L4"
            ]
          },
          "hard": {
            "type": "boolean"
          },
          "bandA": {
            "anyOf": [
              {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              {
                "type": "null"
              }
            ]
          },
          "scenarioB": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[A-Za-z]+$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "band": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                },
                "rule": {
                  "type": "string"
                },
                "hard": {
                  "type": "boolean"
                }
              },
              "required": [
                "hard"
              ],
              "additionalProperties": false
            },
            "minProperties": 0
          },
          "tolerance": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "toleranceAbs": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "reference": {
            "type": "object",
            "properties": {
              "mean": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "p10": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "p90": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "ci90": {
                "anyOf": [
                  {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "items": false,
                    "minItems": 2,
                    "maxItems": 2
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "source": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "extractorVersion": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "rows": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "mean",
              "p10",
              "p90",
              "ci90",
              "source",
              "extractorVersion",
              "rows"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "unit",
          "layer",
          "hard",
          "bandA",
          "scenarioB",
          "tolerance",
          "toleranceAbs",
          "reference"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "metrics"
  ],
  "additionalProperties": false
}
