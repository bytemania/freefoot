{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai_coach.schema.json",
  "title": "ai_coach.yaml",
  "type": "object",
  "properties": {
    "evalIntervalTicks": {
      "type": "integer"
    },
    "tiredSubstitution": {
      "type": "object",
      "properties": {
        "earliestMinute": {
          "type": "number"
        },
        "fitnessThreshold": {
          "type": "number"
        },
        "injuryLevels": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "LIGHT",
              "MEDIUM",
              "HIGH"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [
        "earliestMinute",
        "fitnessThreshold",
        "injuryLevels"
      ],
      "additionalProperties": false
    },
    "losingLate": {
      "type": "object",
      "properties": {
        "minute": {
          "type": "number"
        },
        "formationId": {
          "type": "string",
          "pattern": "^[0-9](-[0-9]){2,3}$"
        }
      },
      "required": [
        "minute",
        "formationId"
      ],
      "additionalProperties": false
    },
    "redCard": {
      "type": "object",
      "properties": {
        "formationId": {
          "type": "string",
          "pattern": "^[0-9](-[0-9]){2,3}$"
        }
      },
      "required": [
        "formationId"
      ],
      "additionalProperties": false
    },
    "maxSubstitutionsPerCheck": {
      "type": "integer"
    },
    "substitutionPlan": {
      "type": "object",
      "properties": {
        "maxSubstitutions": {
          "type": "integer"
        },
        "maxWindows": {
          "type": "integer"
        },
        "plannedThree": {
          "type": "number"
        },
        "plannedFour": {
          "type": "number"
        },
        "twoWindowMinutes": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "threeWindowMinutes": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "jitterMinutes": {
          "type": "number"
        },
        "chasingShiftMinutes": {
          "type": "number"
        },
        "leadingShiftMinutes": {
          "type": "number"
        },
        "earliestMinute": {
          "type": "number"
        },
        "latestMinute": {
          "type": "number"
        },
        "injuryScore": {
          "type": "number"
        },
        "yellowCardScore": {
          "type": "number"
        },
        "exhaustedScore": {
          "type": "number"
        },
        "roleScore": {
          "type": "number"
        }
      },
      "required": [
        "maxSubstitutions",
        "maxWindows",
        "plannedThree",
        "plannedFour",
        "twoWindowMinutes",
        "threeWindowMinutes",
        "jitterMinutes",
        "chasingShiftMinutes",
        "leadingShiftMinutes",
        "earliestMinute",
        "latestMinute",
        "injuryScore",
        "yellowCardScore",
        "exhaustedScore",
        "roleScore"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "evalIntervalTicks",
    "tiredSubstitution",
    "losingLate",
    "redCard",
    "maxSubstitutionsPerCheck",
    "substitutionPlan"
  ],
  "additionalProperties": false
}
