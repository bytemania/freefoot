{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai_coach.schema.json",
  "title": "ai_coach.yaml",
  "type": "object",
  "properties": {
    "evalIntervalTicks": {
      "type": "integer"
    },
    "tiredSubstitution": {
      "type": "object",
      "properties": {
        "earliestMinute": {
          "type": "number"
        },
        "fitnessThreshold": {
          "type": "number"
        },
        "injuryLevels": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "LIGHT",
              "MEDIUM",
              "HIGH"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [
        "earliestMinute",
        "fitnessThreshold",
        "injuryLevels"
      ],
      "additionalProperties": false
    },
    "losingLate": {
      "type": "object",
      "properties": {
        "minute": {
          "type": "number"
        },
        "formationId": {
          "type": "string",
          "pattern": "^[0-9](-[0-9]){2,3}$"
        }
      },
      "required": [
        "minute",
        "formationId"
      ],
      "additionalProperties": false
    },
    "redCard": {
      "type": "object",
      "properties": {
        "formationId": {
          "type": "string",
          "pattern": "^[0-9](-[0-9]){2,3}$"
        }
      },
      "required": [
        "formationId"
      ],
      "additionalProperties": false
    },
    "maxSubstitutionsPerCheck": {
      "type": "integer"
    }
  },
  "required": [
    "evalIntervalTicks",
    "tiredSubstitution",
    "losingLate",
    "redCard",
    "maxSubstitutionsPerCheck"
  ],
  "additionalProperties": false
}
