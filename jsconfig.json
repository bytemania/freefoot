{
  "compilerOptions": {
    "checkJs": true,
    "maxNodeModuleJsDepth": 0,
    "skipLibCheck": true,
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "types": ["node", "vite/client"]
  },
  "include": ["src", "scripts", "tests", "generated"]
}
